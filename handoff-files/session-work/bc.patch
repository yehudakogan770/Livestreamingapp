            .stop('vertical')
            .then(() => broadcaster.startVertical(settingsRef.current, recordingName(showRef.current), rehearsalRef.current))
            .then(
              () => setVerticalTrouble(null),
              (e: unknown) => setVerticalTrouble(e instanceof Error ? e.message : String(e)),
            );
        });
