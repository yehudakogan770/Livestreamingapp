{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumora Photo",
  "mainBinaryName": "Lumora Photo",
  "version": "0.1.0",
  "identifier": "app.lumora.photo",
  "build": {
    "beforeDevCommand": "npm --prefix .. run photo:ui:dev",
    "devUrl": "http://localhost:1435",
    "beforeBuildCommand": "npm --prefix .. run photo:ui:build",
    "frontendDist": "../../dist-photo"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumora Photo",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#1b1b1a",
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; worker-src 'self' blob:; script-src 'self' blob: 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lumora",
    "category": "Photography",
    "shortDescription": "Photo editing and design",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["lumphoto"],
        "name": "Lumora Photo document",
        "description": "Lumora Photo document",
        "role": "Editor"
      },
      {
        "ext": ["psd"],
        "name": "Photoshop document",
        "description": "Photoshop document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1OThFREY0OEQxQ0ZCM0MKUldROCt4eU45TzJZSlNnMGxnZGF6MnEvV1ZhNXhOTFU1SXBIaE1pWlRRYmhXYTVBQkpOQkxBMEUK",
      "endpoints": ["https://github.com/yehudakogan770/Livestreamingapp/releases/latest/download/latest-photo.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
